# Copy to .env (optional). The app works without any key here: visitors paste their own key in the UI.
# Uncomment ONE of these only if you want a server-side fallback key (it will be used for visitors who
# leave the key field empty, and spend your credit). The provider is detected from the key's prefix.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: default model per provider
# MODEL=openai/gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: pin "today" for deadline math, e.g. TODAY=2026-02-01 makes the CL-2048 appeal window still open
# TODAY=2026-02-01
